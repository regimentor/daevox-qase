{
  "name": "@app/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "typecheck": "react-router typegen && tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "node scripts/check-codegen.mjs",
    "lint:boundaries": "node scripts/check-fsd-boundaries.mjs",
    "test": "vitest run",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test:coverage": "node scripts/run-coverage.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e": "node scripts/run-e2e.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@apollo/client": "4.2.12",
    "antd": "6.6.1",
    "graphql": "16.11.0",
    "isbot": "^5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "6.3.1",
    "@graphql-codegen/typed-document-node": "6.1.8",
    "@graphql-codegen/typescript": "5.0.10",
    "@graphql-codegen/typescript-operations": "5.1.0",
    "@react-router/dev": "8.3.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "vite": "8.2.1"
  }
}
