{
  "name": "@app/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/main.js",
  "scripts": {
    "prebuild": "node --import tsx src/schema/generate-types.ts",
    "build": "tsc -p tsconfig.json && cp src/schema/schema.graphql dist/src/schema/schema.graphql",
    "dev": "npm run build && node --watch dist/src/main.js",
    "start": "node dist/src/main.js",
    "typecheck": "npm run build -w @app/storage && node --import tsx src/schema/generate-types.ts && tsc -p tsconfig.json --noEmit",
    "attachments:cleanup": "node --import tsx src/commands/cleanup-pending-attachments.ts"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@app/storage": "0.1.0",
    "@as-integrations/express5": "1.1.2",
    "@aws-sdk/client-s3": "3.1114.0",
    "@aws-sdk/s3-request-presigner": "3.1114.0",
    "@graphql-tools/utils": "11.0.0",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/graphql": "13.4.5",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/throttler": "6.4.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dataloader": "2.2.3",
    "express": "5.1.0",
    "graphql": "16.11.0",
    "graphql-depth-limit": "1.1.0",
    "graphql-query-complexity": "1.1.0",
    "helmet": "8.1.0",
    "jose": "6.2.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ulidx": "2.4.1",
    "zod": "4.1.12"
  }
}
