FROM node:22.22.2-bookworm-slim AS build

WORKDIR /app

RUN apt-get update \
  && apt-get install --no-install-recommends --yes openssl \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json tsconfig.base.json ./
COPY backend/api/package.json backend/api/package.json
COPY backend/storage/package.json backend/storage/package.json
COPY frontend/web/package.json frontend/web/package.json

RUN npm ci

COPY frontend frontend

ARG VITE_GRAPHQL_URL=/graphql
ENV VITE_GRAPHQL_URL=${VITE_GRAPHQL_URL}

RUN npm run build:web

FROM nginx:1.27.5-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/web/build/client /usr/share/nginx/html

EXPOSE 80
