NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://daevox:daevox@localhost:5432/daevox?schema=public
# Generate an Ed25519 pair for production. These development placeholders are not secrets.
ACCESS_TOKEN_PRIVATE_KEY=base64-encoded-pkcs8-private-key
ACCESS_TOKEN_PUBLIC_KEY=base64-encoded-spki-public-key
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
CORS_ORIGINS=http://localhost:3001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=daevox-attachments
S3_ACCESS_KEY_ID=seaweed-local-user
S3_SECRET_ACCESS_KEY=replace-for-local-development
S3_FORCE_PATH_STYLE=true
ATTACHMENT_MAX_BYTES=26214400
ATTACHMENT_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp,application/pdf,text/plain,application/json
SEED_DEMO_PASSWORD=replace-with-at-least-12-characters
ALLOW_PRODUCTION_SEED=false
VITE_GRAPHQL_URL=/graphql

# Production Compose variables. deploy/init.sh replaces these placeholders
# with generated values and keeps the resulting .env private.
NGINX_PORT=8080
POSTGRES_USER=daevox
POSTGRES_PASSWORD=replace-for-local-development
POSTGRES_DB=daevox
S3_PORT=9000
# Empty uses S3_ENDPOINT. Production requires a browser-accessible S3 origin.
S3_PUBLIC_ENDPOINT=
